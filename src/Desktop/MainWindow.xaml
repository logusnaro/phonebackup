<Window x:Class="PhoneBackup.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="업무폰 통합 백업" Icon="Assets/phonebackup.ico" Height="760" Width="1180" MinHeight="620" MinWidth="920"
        WindowStartupLocation="CenterScreen">
  <Grid Margin="20">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel Grid.Row="0" Margin="0,0,0,16">
      <StackPanel DockPanel.Dock="Left"><TextBlock Text="업무폰 통합 백업" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="로컬 Wi‑Fi · 원본 보존 · 메타데이터 색인" Foreground="#65727A"/></StackPanel>
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
        <Button Content="새 멤버" Click="AddMember_Click" Padding="14,7" Margin="4"/>
        <Button Content="기기 연결" Click="PairDevice_Click" Padding="14,7" Margin="4"/>
        <Button Content="수동 백업" Click="ManualBackup_Click" Padding="14,7" Margin="4" Background="#146C94" Foreground="White"/>
      </StackPanel>
    </DockPanel>
    <TabControl Grid.Row="1">
      <TabItem Header="대시보드"><Grid Margin="8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <UniformGrid Columns="4" Margin="0,0,0,14">
          <Border Background="#E8F3F8" CornerRadius="8" Margin="4" Padding="14"><StackPanel><TextBlock Text="연결 기기" Foreground="#65727A"/><TextBlock x:Name="DeviceCountText" Text="0" FontSize="28" FontWeight="Bold"/></StackPanel></Border>
          <Border Background="#F4F1E8" CornerRadius="8" Margin="4" Padding="14"><StackPanel><TextBlock Text="마지막 백업" Foreground="#65727A"/><TextBlock x:Name="LastBackupText" Text="없음" FontSize="18" FontWeight="Bold"/></StackPanel></Border>
          <Border Background="#EAF5ED" CornerRadius="8" Margin="4" Padding="14"><StackPanel><TextBlock Text="승인 대기 연락처" Foreground="#65727A"/><TextBlock x:Name="ProposalCountText" Text="0" FontSize="28" FontWeight="Bold"/></StackPanel></Border>
          <Border Background="#F8ECE8" CornerRadius="8" Margin="4" Padding="14"><StackPanel><TextBlock Text="삭제 추천" Foreground="#65727A"/><TextBlock x:Name="DeletionCountText" Text="0" FontSize="28" FontWeight="Bold"/></StackPanel></Border>
        </UniformGrid>
        <Border Grid.Row="1" Background="#F3F6F8" CornerRadius="8" Padding="14" Margin="4,0,4,14"><StackPanel><DockPanel><TextBlock Text="백업 진행 상황" FontWeight="SemiBold"/><TextBlock x:Name="ConnectionText" Text="기기 연결 확인 중…" DockPanel.Dock="Right" Foreground="#65727A"/></DockPanel><ProgressBar x:Name="BackupProgressBar" Height="12" Margin="0,10,0,7" Minimum="0" Maximum="100" Value="0"/><TextBlock x:Name="BackupProgressText" Text="진행 중인 백업이 없습니다." TextTrimming="CharacterEllipsis"/></StackPanel></Border>
        <DataGrid Grid.Row="2" x:Name="ActivityGrid" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"><DataGrid.Columns><DataGridTextColumn Header="시간" Binding="{Binding Time}" Width="180"/><DataGridTextColumn Header="대상" Binding="{Binding Target}" Width="220"/><DataGridTextColumn Header="상태" Binding="{Binding Status}" Width="120"/><DataGridTextColumn Header="내용" Binding="{Binding Message}" Width="*"/></DataGrid.Columns></DataGrid>
      </Grid></TabItem>
      <TabItem Header="멤버·기기"><Grid Margin="8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="180"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel Orientation="Horizontal"><Button Content="멤버 삭제(보관)" Click="ArchiveMember_Click" Padding="12,6" Margin="0,0,8,8"/><Button Content="멤버 복원" Click="RestoreMember_Click" Padding="12,6" Margin="0,0,8,8"/></StackPanel><DataGrid Grid.Row="1" x:Name="MembersGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionChanged="MembersGrid_SelectionChanged"><DataGrid.Columns><DataGridTextColumn Header="멤버" Binding="{Binding Name}" Width="220"/><DataGridTextColumn Header="상태" Binding="{Binding Status}" Width="120"/><DataGridTextColumn Header="생성일" Binding="{Binding CreatedAt}" Width="200"/></DataGrid.Columns></DataGrid><DataGrid Grid.Row="2" x:Name="DevicesGrid" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="기기명" Binding="{Binding DisplayName}" Width="220"/><DataGridTextColumn Header="모델" Binding="{Binding Model}" Width="160"/><DataGridTextColumn Header="상태" Binding="{Binding Status}" Width="120"/><DataGridTextColumn Header="최근 연결" Binding="{Binding LastSeenAt}" Width="220"/></DataGrid.Columns></DataGrid><TextBlock Grid.Row="3" Text="멤버 삭제는 보관 전환으로 처리되며 연결 기기·파일·주소록 이력은 DB에 유지됩니다. 기기 연결은 위에서 멤버를 선택한 뒤 상단의 ‘기기 연결’을 누릅니다." TextWrapping="Wrap" Foreground="#65727A" Margin="4,12"/></Grid></TabItem>
      <TabItem Header="주소록"><Grid Margin="8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel Orientation="Horizontal"><Button Content="새 연락처" Click="AddContact_Click" Padding="12,6" Margin="0,0,8,8"/><Button Content="연락처 수정" Click="EditContact_Click" Padding="12,6" Margin="0,0,8,8"/><Button Content="연락처 삭제" Click="DeleteContact_Click" Padding="12,6" Margin="0,0,8,8"/><Button Content="CSV 내보내기" Click="ExportContacts_Click" Padding="12,6" Margin="0,0,8,8"/><Button Content="새로고침" Click="RefreshContacts_Click" Padding="12,6" Margin="0,0,8,8"/></StackPanel><DataGrid x:Name="ContactsGrid" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="이름" Binding="{Binding DisplayName}" Width="220"/><DataGridTextColumn Header="전화번호" Binding="{Binding PhoneNumbers}" Width="240"/><DataGridTextColumn Header="이메일" Binding="{Binding Emails}" Width="240"/><DataGridTextColumn Header="회사" Binding="{Binding Company}" Width="*"/></DataGrid.Columns></DataGrid></Grid></TabItem>
      <TabItem Header="통화 녹음"><Grid Margin="8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel Orientation="Horizontal"><TextBox x:Name="SearchBox" Width="300" Padding="8" Margin="0,0,8,8" ToolTip="파일명·상대방·전화번호 검색"/><Button Content="검색" Click="SearchFiles_Click" Padding="12,6" Margin="0,0,8,8"/><Button Content="백업 폴더 설정" Click="ChooseRoot_Click" Padding="12,6" Margin="0,0,8,8"/><TextBlock Text="파일을 더블클릭하면 실행됩니다" Foreground="#65727A" VerticalAlignment="Center"/></StackPanel><DataGrid x:Name="RecordingGrid" AutoGenerateColumns="False" IsReadOnly="True" MouseDoubleClick="FileGrid_MouseDoubleClick"><DataGrid.Columns><DataGridTextColumn Header="모바일" Binding="{Binding MemberName}" Width="120"/><DataGridTextColumn Header="분류" Binding="{Binding Category}" Width="110"/><DataGridTextColumn Header="녹음일" Binding="{Binding RecordedAt}" Width="170"/><DataGridTextColumn Header="상대방" Binding="{Binding ParsedContactName}" Width="160"/><DataGridTextColumn Header="원본 파일명" Binding="{Binding OriginalFileName}" Width="*"/><DataGridTextColumn Header="상태" Binding="{Binding Status}" Width="120"/></DataGrid.Columns></DataGrid></Grid></TabItem>
      <TabItem Header="일반 파일"><Grid Margin="8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel Orientation="Horizontal"><TextBox x:Name="GeneralSearchBox" Width="300" Padding="8" Margin="0,0,8,8" ToolTip="파일명·경로 검색"/><Button Content="검색" Click="SearchGeneralFiles_Click" Padding="12,6" Margin="0,0,8,8"/><TextBlock Text="통화 녹음 이외의 사진·영상·문서·기타 파일 · 더블클릭으로 실행" Foreground="#65727A" VerticalAlignment="Center"/></StackPanel><DataGrid x:Name="FilesGrid" AutoGenerateColumns="False" IsReadOnly="True" MouseDoubleClick="FileGrid_MouseDoubleClick"><DataGrid.Columns><DataGridTextColumn Header="모바일" Binding="{Binding MemberName}" Width="120"/><DataGridTextColumn Header="분류" Binding="{Binding Category}" Width="110"/><DataGridTextColumn Header="수정일" Binding="{Binding LastModifiedAt}" Width="170"/><DataGridTextColumn Header="원본 파일명" Binding="{Binding OriginalFileName}" Width="*"/><DataGridTextColumn Header="상태" Binding="{Binding Status}" Width="120"/></DataGrid.Columns></DataGrid></Grid></TabItem>
      <TabItem Header="설정"><StackPanel Margin="18" MaxWidth="700"><TextBlock Text="예약 백업" FontSize="20" FontWeight="SemiBold"/><CheckBox x:Name="ScheduleEnabledCheckBox" Content="예약 백업 활성화 (기본값: 꺼짐)" Checked="ScheduleToggle_Click" Unchecked="ScheduleToggle_Click" Margin="0,12"/><TextBlock Text="백업 시각은 24시간 형식으로 입력하세요. 여러 시각은 쉼표로 구분합니다. PC가 꺼진 회차는 건너뜁니다." TextWrapping="Wrap" Foreground="#65727A"/><StackPanel Orientation="Horizontal" Margin="0,12"><TextBlock Text="백업 시각" VerticalAlignment="Center" Margin="0,0,10,0"/><TextBox x:Name="ScheduleTimesTextBox" Text="19:00" Width="180" Padding="8"/><Button Content="시간 저장" Click="SaveScheduleTime_Click" Padding="12,6" Margin="10,0,0,0"/></StackPanel><Separator Margin="0,20"/><TextBlock Text="삭제 추천 유예기간" FontSize="20" FontWeight="SemiBold"/><StackPanel Orientation="Horizontal" Margin="0,12"><TextBox Text="90" Width="80" Padding="8"/><TextBlock Text=" 일 후 검증 완료 파일만 추천" VerticalAlignment="Center" Margin="8,0"/><Button Content="삭제 후보 새로고침" Click="RefreshDeletionCandidates_Click" Padding="12,6" Margin="12,0,0,0"/></StackPanel><TextBlock Text="휴대폰의 ‘90일 이전 삭제’ 버튼을 눌러 후보를 만들고, 원본 경로·SHA-256 재검사 후 일치하는 파일만 삭제합니다. 자동 삭제는 하지 않습니다." TextWrapping="Wrap" Foreground="#9B4A38"/></StackPanel></TabItem>
    </TabControl>
    <StatusBar Grid.Row="2" Margin="0,14,0,0"><StatusBarItem><TextBlock x:Name="StatusText" Text="준비됨"/></StatusBarItem><Separator/><StatusBarItem><TextBlock x:Name="ServerText" Text="로컬 서버 시작 중…"/></StatusBarItem></StatusBar>
  </Grid>
</Window>
