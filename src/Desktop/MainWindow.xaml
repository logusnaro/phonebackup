<Window x:Class="PhoneBackup.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PB · Smart Switch 백업 관리" Icon="pack://application:,,,/Assets/phonebackup.ico"
        Width="1280" Height="820" MinWidth="980" MinHeight="680" WindowStartupLocation="CenterScreen">
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

    <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="24,18">
      <DockPanel>
        <StackPanel DockPanel.Dock="Left">
          <StackPanel Orientation="Horizontal">
            <Border Width="44" Height="44" CornerRadius="12" Background="{StaticResource PbGreen}" Margin="0,0,12,0">
              <TextBlock Text="PB" Foreground="White" FontWeight="Bold" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel><TextBlock Text="PhoneBackup" FontSize="24" FontWeight="Bold"/><TextBlock Text="Smart Switch 백업 파일 관리 · PC 독립 실행" Foreground="{StaticResource Muted}"/></StackPanel>
          </StackPanel>
        </StackPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Content="Smart Switch 열기" Click="OpenSmartSwitch_Click"/>
          <Button Content="폴더 직접 추가" Click="AddFolder_Click"/>
          <Button Content="백업 자동 찾기" Style="{StaticResource PrimaryButton}" Click="AutoDiscover_Click" Margin="0"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <Border Grid.Row="1" x:Name="ProgressPanel" Background="#E8F5EF" BorderBrush="#B9DDCD" BorderThickness="0,0,0,1" Padding="24,10" Visibility="Collapsed">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock x:Name="ProgressTitle" Text="백업을 확인하고 있습니다" FontWeight="SemiBold" VerticalAlignment="Center"/>
        <StackPanel Grid.Column="1" Margin="16,0"><ProgressBar x:Name="WorkProgress" Height="8" Minimum="0" Maximum="100"/><TextBlock x:Name="ProgressDetail" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/></StackPanel>
        <Button Grid.Column="2" Content="취소" Click="CancelWork_Click" Padding="10,5" Margin="12,0,0,0"/>
      </Grid>
    </Border>

    <TabControl x:Name="MainTabs" Grid.Row="2" Margin="20,16,20,0">
      <TabItem Header="홈">
        <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="2,14">
          <UniformGrid Columns="4">
            <Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,0,10,12"><StackPanel><TextBlock Text="등록된 백업" Foreground="{StaticResource Muted}"/><TextBlock x:Name="SourceCountText" Text="0" FontSize="30" FontWeight="Bold" Margin="0,6,0,0"/><TextBlock Text="Smart Switch 폴더" Foreground="{StaticResource Muted}"/></StackPanel></Border>
            <Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,0,10,12"><StackPanel><TextBlock Text="관리 파일" Foreground="{StaticResource Muted}"/><TextBlock x:Name="FileCountText" Text="0" FontSize="30" FontWeight="Bold" Margin="0,6,0,0"/><TextBlock x:Name="TotalSizeText" Text="0 B" Foreground="{StaticResource Muted}"/></StackPanel></Border>
            <Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,0,10,12"><StackPanel><TextBlock Text="통화녹음" Foreground="{StaticResource Muted}"/><TextBlock x:Name="RecordingCountText" Text="0" FontSize="30" FontWeight="Bold" Margin="0,6,0,0"/><TextBlock Text="파일명 메타데이터 분류" Foreground="{StaticResource Muted}"/></StackPanel></Border>
            <Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,0,0,12"><StackPanel><TextBlock Text="무결성 확인" Foreground="{StaticResource Muted}"/><TextBlock x:Name="VerifiedCountText" Text="0" FontSize="30" FontWeight="Bold" Margin="0,6,0,0"/><TextBlock Text="SHA-256 완료 파일" Foreground="{StaticResource Muted}"/></StackPanel></Border>
          </UniformGrid>
          <Border Background="{StaticResource PbGreenSoft}" CornerRadius="10" Padding="20" Margin="0,4,0,16">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel><TextBlock Text="백업은 Smart Switch, 정리는 PB" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="1. Smart Switch에서 백업 완료  →  2. PB에서 자동 찾기  →  3. 파일 분류와 무결성 확인" Margin="0,8,0,0" Foreground="{StaticResource Muted}"/><TextBlock Text="PB는 Smart Switch 원본을 복사·수정·삭제하지 않습니다." Margin="0,4,0,0" Foreground="{StaticResource PbGreenDark}" FontWeight="SemiBold"/></StackPanel>
              <Button Grid.Column="1" Content="지금 자동 찾기" Style="{StaticResource PrimaryButton}" Click="AutoDiscover_Click" VerticalAlignment="Center" Margin="16,0,0,0"/>
            </Grid>
          </Border>
          <TextBlock Text="최근 등록된 백업" FontSize="18" FontWeight="SemiBold" Margin="4,0,0,8"/>
          <DataGrid x:Name="HomeSourcesGrid" Height="250"><DataGrid.Columns>
            <DataGridTextColumn Header="기종" Binding="{Binding Model}" Width="140"/><DataGridTextColumn Header="폴더" Binding="{Binding DisplayName}" Width="220"/><DataGridTextColumn Header="파일" Binding="{Binding FileCountText}" Width="100"/><DataGridTextColumn Header="용량" Binding="{Binding SizeText}" Width="120"/><DataGridTextColumn Header="마지막 확인" Binding="{Binding LastScanText}" Width="180"/><DataGridTextColumn Header="상태" Binding="{Binding StatusText}" Width="*"/>
          </DataGrid.Columns></DataGrid>
        </StackPanel></ScrollViewer>
      </TabItem>

      <TabItem Header="통화녹음">
        <Grid Margin="2,14"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <DockPanel Margin="0,0,0,10"><StackPanel Orientation="Horizontal" DockPanel.Dock="Left"><TextBox x:Name="RecordingSearch" Width="280" ToolTip="이름·번호·소속·파일명 검색"/><Button Content="검색" Click="SearchRecording_Click"/><ComboBox x:Name="RecordingGroup" Width="130" SelectionChanged="RecordingGroup_SelectionChanged"><ComboBoxItem Content="날짜별" IsSelected="True"/><ComboBoxItem Content="상대방별"/><ComboBoxItem Content="분류 없음"/></ComboBox></StackPanel><StackPanel Orientation="Horizontal" DockPanel.Dock="Right"><Button Content="파일 열기" Click="OpenSelected_Click"/><Button Content="폴더에서 보기" Style="{StaticResource PrimaryButton}" Click="ShowInFolder_Click" Margin="0"/></StackPanel></DockPanel>
          <DataGrid Grid.Row="1" x:Name="RecordingGrid" MouseDoubleClick="FileGrid_MouseDoubleClick"><DataGrid.Columns>
            <DataGridTextColumn Header="녹음일" Binding="{Binding RecordedText}" Width="155"/><DataGridTextColumn Header="대상" Binding="{Binding TargetText}" Width="85"/><DataGridTextColumn Header="상대방" Binding="{Binding CallerText}" Width="150"/><DataGridTextColumn Header="소속" Binding="{Binding AffiliationText}" Width="180"/><DataGridTextColumn Header="전화번호" Binding="{Binding PhoneText}" Width="140"/><DataGridTextColumn Header="기종" Binding="{Binding Model}" Width="105"/><DataGridTextColumn Header="원본 파일명" Binding="{Binding FileName}" Width="*"/><DataGridTextColumn Header="용량" Binding="{Binding SizeText}" Width="95"/><DataGridTextColumn Header="상태" Binding="{Binding StateText}" Width="95"/>
          </DataGrid.Columns></DataGrid>
        </Grid>
      </TabItem>

      <TabItem Header="사진">
        <Grid Margin="2,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <DockPanel Grid.ColumnSpan="2" Margin="0,0,0,10"><TextBox x:Name="ImageSearch" Width="280" DockPanel.Dock="Left"/><Button Content="검색" Tag="image" Click="SearchCategory_Click"/><StackPanel Orientation="Horizontal" DockPanel.Dock="Right"><Button Content="파일 열기" Click="OpenSelected_Click"/><Button Content="폴더에서 보기" Style="{StaticResource PrimaryButton}" Click="ShowInFolder_Click" Margin="0"/></StackPanel></DockPanel>
          <DataGrid Grid.Row="1" x:Name="ImageGrid" SelectionChanged="ImageGrid_SelectionChanged" MouseDoubleClick="FileGrid_MouseDoubleClick"><DataGrid.Columns><DataGridTextColumn Header="수정일" Binding="{Binding ModifiedText}" Width="155"/><DataGridTextColumn Header="기종" Binding="{Binding Model}" Width="110"/><DataGridTextColumn Header="파일명" Binding="{Binding FileName}" Width="*"/><DataGridTextColumn Header="폴더" Binding="{Binding RelativeFolder}" Width="220"/><DataGridTextColumn Header="용량" Binding="{Binding SizeText}" Width="90"/></DataGrid.Columns></DataGrid>
          <Border Grid.Row="1" Grid.Column="1" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10" Margin="12,0,0,0" Padding="12"><Grid><Image x:Name="ImagePreview" Stretch="Uniform"/><TextBlock x:Name="ImagePreviewHint" Text="사진을 선택하면 미리보기가 표시됩니다." TextWrapping="Wrap" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid></Border>
        </Grid>
      </TabItem>

      <TabItem Header="영상"><Grid Margin="2,14"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><DockPanel Margin="0,0,0,10"><TextBox x:Name="VideoSearch" Width="280"/><Button Content="검색" Tag="video" Click="SearchCategory_Click"/><StackPanel Orientation="Horizontal" DockPanel.Dock="Right"><Button Content="파일 열기" Click="OpenSelected_Click"/><Button Content="폴더에서 보기" Style="{StaticResource PrimaryButton}" Click="ShowInFolder_Click" Margin="0"/></StackPanel></DockPanel><DataGrid Grid.Row="1" x:Name="VideoGrid" MouseDoubleClick="FileGrid_MouseDoubleClick"><DataGrid.Columns><DataGridTextColumn Header="수정일" Binding="{Binding ModifiedText}" Width="160"/><DataGridTextColumn Header="기종" Binding="{Binding Model}" Width="120"/><DataGridTextColumn Header="파일명" Binding="{Binding FileName}" Width="*"/><DataGridTextColumn Header="폴더" Binding="{Binding RelativeFolder}" Width="300"/><DataGridTextColumn Header="용량" Binding="{Binding SizeText}" Width="100"/><DataGridTextColumn Header="상태" Binding="{Binding StateText}" Width="100"/></DataGrid.Columns></DataGrid></Grid></TabItem>
      <TabItem Header="문서"><Grid Margin="2,14"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><DockPanel Margin="0,0,0,10"><TextBox x:Name="DocumentSearch" Width="280"/><Button Content="검색" Tag="document" Click="SearchCategory_Click"/><StackPanel Orientation="Horizontal" DockPanel.Dock="Right"><Button Content="파일 열기" Click="OpenSelected_Click"/><Button Content="폴더에서 보기" Style="{StaticResource PrimaryButton}" Click="ShowInFolder_Click" Margin="0"/></StackPanel></DockPanel><DataGrid Grid.Row="1" x:Name="DocumentGrid" MouseDoubleClick="FileGrid_MouseDoubleClick"><DataGrid.Columns><DataGridTextColumn Header="수정일" Binding="{Binding ModifiedText}" Width="160"/><DataGridTextColumn Header="기종" Binding="{Binding Model}" Width="120"/><DataGridTextColumn Header="파일명" Binding="{Binding FileName}" Width="*"/><DataGridTextColumn Header="폴더" Binding="{Binding RelativeFolder}" Width="300"/><DataGridTextColumn Header="용량" Binding="{Binding SizeText}" Width="100"/><DataGridTextColumn Header="상태" Binding="{Binding StateText}" Width="100"/></DataGrid.Columns></DataGrid></Grid></TabItem>
      <TabItem Header="오디오"><Grid Margin="2,14"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><DockPanel Margin="0,0,0,10"><TextBox x:Name="AudioSearch" Width="280"/><Button Content="검색" Tag="audio" Click="SearchCategory_Click"/><StackPanel Orientation="Horizontal" DockPanel.Dock="Right"><Button Content="파일 열기" Click="OpenSelected_Click"/><Button Content="폴더에서 보기" Style="{StaticResource PrimaryButton}" Click="ShowInFolder_Click" Margin="0"/></StackPanel></DockPanel><DataGrid Grid.Row="1" x:Name="AudioGrid" MouseDoubleClick="FileGrid_MouseDoubleClick"><DataGrid.Columns><DataGridTextColumn Header="수정일" Binding="{Binding ModifiedText}" Width="160"/><DataGridTextColumn Header="기종" Binding="{Binding Model}" Width="120"/><DataGridTextColumn Header="파일명" Binding="{Binding FileName}" Width="*"/><DataGridTextColumn Header="폴더" Binding="{Binding RelativeFolder}" Width="300"/><DataGridTextColumn Header="용량" Binding="{Binding SizeText}" Width="100"/><DataGridTextColumn Header="상태" Binding="{Binding StateText}" Width="100"/></DataGrid.Columns></DataGrid></Grid></TabItem>
      <TabItem Header="기타·삼성 데이터"><Grid Margin="2,14"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><DockPanel Margin="0,0,0,10"><TextBox x:Name="OtherSearch" Width="280"/><Button Content="검색" Tag="other" Click="SearchCategory_Click"/><TextBlock Text="삼성 전용 데이터는 목록만 표시되며 PB에서 해석하지 않습니다." Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="8,0"/><StackPanel Orientation="Horizontal" DockPanel.Dock="Right"><Button Content="파일 열기" Click="OpenSelected_Click"/><Button Content="폴더에서 보기" Style="{StaticResource PrimaryButton}" Click="ShowInFolder_Click" Margin="0"/></StackPanel></DockPanel><DataGrid Grid.Row="1" x:Name="OtherGrid" MouseDoubleClick="FileGrid_MouseDoubleClick"><DataGrid.Columns><DataGridTextColumn Header="유형" Binding="{Binding CategoryText}" Width="130"/><DataGridTextColumn Header="수정일" Binding="{Binding ModifiedText}" Width="160"/><DataGridTextColumn Header="기종" Binding="{Binding Model}" Width="120"/><DataGridTextColumn Header="파일명" Binding="{Binding FileName}" Width="*"/><DataGridTextColumn Header="폴더" Binding="{Binding RelativeFolder}" Width="280"/><DataGridTextColumn Header="용량" Binding="{Binding SizeText}" Width="100"/></DataGrid.Columns></DataGrid></Grid></TabItem>

      <TabItem Header="백업 폴더"><Grid Margin="2,14"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel Orientation="Horizontal" Margin="0,0,0,10"><Button Content="선택 폴더 다시 색인" Style="{StaticResource PrimaryButton}" Click="RescanSource_Click"/><Button Content="선택 폴더 무결성 확인" Click="VerifySource_Click"/><Button Content="탐색기에서 열기" Click="OpenSource_Click"/><Button Content="목록에서 제거" Style="{StaticResource DangerButton}" Click="RemoveSource_Click"/></StackPanel><DataGrid Grid.Row="1" x:Name="SourcesGrid"><DataGrid.Columns><DataGridTextColumn Header="기종" Binding="{Binding Model}" Width="130"/><DataGridTextColumn Header="표시 이름" Binding="{Binding DisplayName}" Width="180"/><DataGridTextColumn Header="원본 경로" Binding="{Binding RootPath}" Width="*"/><DataGridTextColumn Header="파일" Binding="{Binding FileCountText}" Width="100"/><DataGridTextColumn Header="용량" Binding="{Binding SizeText}" Width="110"/><DataGridTextColumn Header="마지막 확인" Binding="{Binding LastScanText}" Width="180"/><DataGridTextColumn Header="상태" Binding="{Binding StatusText}" Width="100"/></DataGrid.Columns></DataGrid><Border Grid.Row="2" Background="#FFF7E8" CornerRadius="8" Padding="14" Margin="0,12,0,0"><TextBlock Text="안전 원칙: PB는 Smart Switch 백업 폴더를 읽기 전용으로 색인합니다. 파일을 개별 삭제하면 Smart Switch 복원이 깨질 수 있으므로 삭제 기능은 제공하지 않습니다. ‘목록에서 제거’는 PB 색인만 지우며 원본 파일에는 손대지 않습니다." TextWrapping="Wrap" Foreground="#7A5310"/></Border></Grid></TabItem>
      <TabItem Header="설정·도움말"><ScrollViewer><StackPanel Margin="18" MaxWidth="760" HorizontalAlignment="Left"><TextBlock Text="독립 실행 모드" FontSize="22" FontWeight="Bold"/><TextBlock Text="PC 앱은 휴대폰과 연결하거나 데이터를 비교하지 않습니다. Wi‑Fi·USB 디버깅·방화벽 설정이 필요 없습니다." Margin="0,8,0,24" TextWrapping="Wrap" Foreground="{StaticResource Muted}"/><TextBlock Text="오류 대응" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="문제가 생기면 개인정보를 제거한 오류 리포트를 내보내 이 Codex 대화에 첨부하세요." Margin="0,8,0,12" Foreground="{StaticResource Muted}"/><Button Content="오류 리포트 내보내기" Style="{StaticResource PrimaryButton}" Click="ExportDiagnostics_Click" HorizontalAlignment="Left"/><Separator Margin="0,28"/><TextBlock Text="이전 버전 데이터" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="기존 멤버·기기·연락처·PB 복사본은 삭제하지 않고 로컬 DB와 기존 저장 폴더에 보존됩니다. 새 버전에서는 표시하거나 변경하지 않습니다." Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{StaticResource Muted}"/></StackPanel></ScrollViewer></TabItem>
    </TabControl>

    <StatusBar Grid.Row="3" Margin="20,10,20,12" Background="Transparent"><StatusBarItem><TextBlock x:Name="StatusText" Text="준비됨"/></StatusBarItem><Separator/><StatusBarItem><TextBlock Text="PB 2.0 · PC/모바일 독립 실행" Foreground="{StaticResource Muted}"/></StatusBarItem></StatusBar>
  </Grid>
</Window>
