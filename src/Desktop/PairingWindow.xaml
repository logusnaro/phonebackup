<Window x:Class="PhoneBackup.Desktop.PairingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Android 기기 연결" Width="520" Height="330" WindowStartupLocation="CenterOwner">
    <StackPanel Margin="24">
        <TextBlock Text="Android 기기 연결" FontSize="24" FontWeight="SemiBold"/>
        <TextBlock x:Name="MemberText" Text="연결 대상 멤버" FontSize="16" FontWeight="SemiBold" Margin="0,10,0,0"/>
        <TextBlock Text="처음 연결은 USB 등록 파일을 사용하거나, 같은 Wi‑Fi에서 6자리 코드를 입력할 수 있습니다." TextWrapping="Wrap" Margin="0,12,0,20" Foreground="#65727A"/>
        <TextBlock Text="연결 코드" HorizontalAlignment="Center" Foreground="#65727A"/>
        <TextBlock x:Name="CodeText" Text="------" FontSize="42" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,2,0,8"/>
        <TextBlock x:Name="ExpiresText" TextWrapping="Wrap" HorizontalAlignment="Center" Foreground="#65727A"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
            <Button Content="USB 등록 파일 저장" Click="SaveUsbFile_Click" Padding="18,7" Margin="0,0,10,0"/>
            <Button Content="닫기" Click="Close_Click" Padding="18,7"/>
        </StackPanel>
    </StackPanel>
</Window>
